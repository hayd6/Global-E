{
  "name": "Global-E Executive Liquid Theme",
  "dataColors": [
    "#0D9488",
    "#4F46E5",
    "#D97706",
    "#E11D48",
    "#059669",
    "#0EA5E9",
    "#64748B",
    "#7C3AED",
    "#F59E0B"
  ],
  "background": "#F8FAFC",
  "foreground": "#0F172A",
  "tableAccent": "#0D9488",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E2E8F0" } },
            "radius": 12
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#0F172A" } },
            "transparency": 92,
            "shadowBlur": 8,
            "position": "Outer"
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#0F172A" } },
            "fontSize": 12.5,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "subTitle": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#64748B" } },
            "fontSize": 9.5,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#0D9488" } },
            "fontSize": 24,
            "fontFamily": "Segoe UI Bold"
          }
        ],
        "categoryLabels": [
          {
            "show": false,
            "color": { "solid": { "color": "#64748B" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#0F172A" } },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "autoSizeColumnWidth": true,
            "wordWrap": true
          }
        ],
        "values": [
          {
            "fontSize": 11,
            "fontFamily": "Segoe UI",
            "fontColorPrimary": { "solid": { "color": "#0F172A" } },
            "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "backColorSecondary": { "solid": { "color": "#F8FAFC" } },
            "wordWrap": true
          }
        ],
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#E2E8F0" } },
            "gridVertical": true,
            "gridVerticalColor": { "solid": { "color": "#F1F5F9" } },
            "rowPadding": 10,
            "outlineColor": { "solid": { "color": "#0F172A" } },
            "outlineWeight": 1
          }
        ],
        "total": [
          {
            "totals": false
          }
        ]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "categoryAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#1E293B" } },
            "fontSize": 10.5,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#64748B" } },
            "fontSize": 9.5,
            "fontFamily": "Segoe UI",
            "gridlineShow": true,
            "gridlineColor": { "solid": { "color": "#F1F5F9" } }
          }
        ],
        "labels": [
          {
            "show": true,
            "color": { "solid": { "color": "#0F172A" } },
            "fontSize": 9.5,
            "fontFamily": "Segoe UI Semibold",
            "labelPosition": "OutsideEnd"
          }
        ],
        "legend": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#334155" } },
            "fontSize": 9.5,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "categoryAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#1E293B" } },
            "fontSize": 10.5,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#64748B" } },
            "fontSize": 9.5,
            "fontFamily": "Segoe UI",
            "gridlineShow": true,
            "gridlineColor": { "solid": { "color": "#F1F5F9" } }
          }
        ],
        "labels": [
          {
            "show": true,
            "color": { "solid": { "color": "#0F172A" } },
            "fontSize": 9.5,
            "fontFamily": "Segoe UI Semibold",
            "labelPosition": "OutsideEnd"
          }
        ],
        "legend": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#334155" } },
            "fontSize": 9.5,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "areaChart": {
      "*": {
        "categoryAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#1E293B" } },
            "fontSize": 10.5,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#64748B" } },
            "fontSize": 9.5,
            "fontFamily": "Segoe UI",
            "gridlineShow": true,
            "gridlineColor": { "solid": { "color": "#F1F5F9" } }
          }
        ],
        "labels": [
          {
            "show": true,
            "color": { "solid": { "color": "#0F172A" } },
            "fontSize": 9.5,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#F8FAFC" } },
            "transparency": 0
          }
        ]
      }
    }
  }
}
